{
  "manifest_version": 3,
  "name": "YT Playlist Builder",
  "version": "0.2.0",
  "description": "Turn a pasted list of songs into a YouTube playlist.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Playlist Builder"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["identity", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "705067221235-plhoe9vke814ecsnh8h6rcttvjva2vdr.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/youtube"]
  }
}
